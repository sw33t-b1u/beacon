# CTI Platform console image: BEACON web + TRACE CLI in one Cloud Run service.
# Build from the BEACON repository root:
#   docker build -f Dockerfile.cti-console -t cti-console .
# TRACE_REF defaults to the latest TRACE main. Pass a commit/tag to pin:
#   docker build -f Dockerfile.cti-console --build-arg TRACE_REF=<commit-or-tag> -t cti-console .

FROM python:3.12-slim AS trace-source

ARG TRACE_REF=main

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --filter=blob:none https://github.com/sw33t-b1u/trace.git trace \
    && cd trace \
    && git checkout --detach "${TRACE_REF}" \
    && rm -rf .git

FROM python:3.12-slim

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Dependency layers (cache-optimized, no dev dependencies).
# BEACON comes from the local build context; TRACE comes from the pinned tag
# fetched in the trace-source stage.
COPY pyproject.toml uv.lock* /app/beacon/
RUN cd /app/beacon && uv sync --no-install-project --no-dev --frozen

COPY --from=trace-source /src/trace/pyproject.toml /src/trace/uv.lock /app/trace/
RUN cd /app/trace && uv sync --no-install-project --no-dev --frozen

# Copy BEACON
COPY src/ /app/beacon/src/
COPY cmd/ /app/beacon/cmd/
COPY schema/ /app/beacon/schema/
RUN cd /app/beacon && uv sync --no-dev --frozen

# Copy TRACE
COPY --from=trace-source /src/trace/src/ /app/trace/src/
COPY --from=trace-source /src/trace/cmd/ /app/trace/cmd/
COPY --from=trace-source /src/trace/schema/ /app/trace/schema/
COPY --from=trace-source /src/trace/input/source_catalog.example.yaml /app/trace/input/source_catalog.example.yaml
RUN cd /app/trace && uv sync --no-dev --frozen

ENV TRACE_ROOT_PATH=/app/trace
ENV PYTHONPATH=/app/beacon/src

EXPOSE 8000

ENTRYPOINT ["sh", "-c", "cd /app/beacon && uv run beacon web --host 0.0.0.0 --port ${PORT:-8000}"]
