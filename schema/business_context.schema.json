        "user_account_id": {
          "title": "User Account Id",
          "type": "string"
        },
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "first_seen": {
          "default": "",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "default": "",
          "title": "Last Seen",
          "type": "string"
        }
      },
      "required": [
        "user_account_id",
        "asset_id"
      ],
      "title": "AccountOnAsset",
      "type": "object"
    },
