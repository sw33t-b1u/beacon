    "UserAccount": {
      "description": "An individual login account on internal hosts.\n\n``account_type`` strictly follows STIX 2.1 §6.4 ``account-type-ov``.\nEmpty string is the documented default for \"unspecified / no\nsuitable spec value\". 0.12.1 dropped operationally-named extensions\n(``service`` / ``other`` / ``unix-account`` / ``azure-ad`` etc) —\noperational distinctions move to:\n\n- ``is_service_account: bool`` (STIX 2.1 §6.4 native property) for\n  service / automation accounts.\n- ``description`` for free-form context (e.g. \"Azure AD tenant\n  contoso.onmicrosoft.com\") when STIX has no suitable\n  ``account_type`` value.\n\nMigration (existing user_accounts.json):\n- ``unix-account`` → ``unix`` (rename to spec value)\n- ``service`` → empty string + ensure ``is_service_account: true``\n- ``other`` → empty string\n- ``azure-ad`` / ``google-workspace`` / ``saas`` / ``kerberos`` →\n  empty string (STIX has no spec value); add note in\n  ``description``.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "account_login": {
          "title": "Account Login",
          "type": "string"
        },
        "display_name": {
          "default": "",
          "title": "Display Name",
          "type": "string"
        },
        "account_type": {
          "default": "",
          "enum": [
            "",
            "unix",
            "windows-local",
            "windows-domain",
            "ldap",
            "tacacs",
            "radius",
            "nis",
            "openid",
            "facebook",
            "skype",
            "twitter",
            "kavi"
          ],
          "title": "Account Type",
          "type": "string"
        },
        "is_privileged": {
          "default": false,
          "title": "Is Privileged",
          "type": "boolean"
        },
        "is_service_account": {
          "default": false,
          "title": "Is Service Account",
          "type": "boolean"
        },
        "identity_id": {
          "default": "",
          "title": "Identity Id",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "account_login"
      ],
      "title": "UserAccount",
      "type": "object"
    }
