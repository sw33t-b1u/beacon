    "Identity": {
      "description": "Person / role / group / organization granted access to assets.\n\nMaps onto a STIX 2.1 §4.4 identity SDO when emitted to SAGE. ``id`` is\nBEACON-internal (stable string the analyst chooses); SAGE assigns the\nfinal ``identity--<uuid>`` STIX id at ingest.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "identity_class": {
          "default": "group",
          "enum": [
            "individual",
            "group",
            "system",
            "organization",
            "class",
            "unknown"
