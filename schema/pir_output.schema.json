{
  "$defs": {
    "CapabilityComponent": {
      "additionalProperties": true,
      "properties": {
        "breadth": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Breadth",
          "type": "number"
        },
        "depth": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Depth",
          "type": "number"
        },
        "evasion_capability": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Evasion Capability",
          "type": "number"
        },
        "ir_observed_capability": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ir Observed Capability",
          "type": "number"
        },
        "recency_active_campaigns": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Recency Active Campaigns",
          "type": "number"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "sophistication_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Sophistication Score",
          "type": "number"
        },
        "targeting_persistence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Targeting Persistence",
          "type": "number"
        },
        "tool_sophistication": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tool Sophistication",
          "type": "number"
        },
        "ttp_count_norm": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ttp Count Norm",
          "type": "number"
        }
      },
      "required": [
        "score",
        "sophistication_score",
        "ttp_count_norm",
        "recency_active_campaigns"
      ],
      "title": "CapabilityComponent",
      "type": "object"
    },
    "DataQualityComponent": {
      "properties": {
        "degraded": {
          "default": false,
          "title": "Degraded",
          "type": "boolean"
        },
        "ir_boost_skipped": {
          "default": false,
          "title": "Ir Boost Skipped",
          "type": "boolean"
        },
        "missing_sources": {
          "items": {
            "type": "string"
          },
          "title": "Missing Sources",
          "type": "array"
        }
      },
      "title": "DataQualityComponent",
      "type": "object"
    },
    "IntentComponent": {
      "additionalProperties": true,
      "properties": {
        "industry_match": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Industry Match",
          "type": "number"
        },
        "motivation_alignment": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Motivation Alignment",
          "type": "number"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "score",
        "motivation_alignment",
        "industry_match"
      ],
      "title": "IntentComponent",
      "type": "object"
    },
    "OpportunityComponent": {
      "additionalProperties": true,
      "properties": {
        "geographic_match": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Geographic Match",
          "type": "number"
        },
        "ir_observed_opportunity": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ir Observed Opportunity",
          "type": "number"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "surface_ttp_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Surface Ttp Coverage",
          "type": "number"
        },
        "victimology_match": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Victimology Match",
          "type": "number"
        }
      },
      "required": [
        "score",
        "victimology_match",
        "geographic_match",
        "surface_ttp_coverage"
      ],
      "title": "OpportunityComponent",
      "type": "object"
    },
    "PIROutput": {
      "properties": {
        "asset_weight_rules": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Asset Weight Rules",
          "type": "array"
        },
        "collection_focus": {
          "items": {
            "type": "string"
          },
          "title": "Collection Focus",
          "type": "array"
        },
        "decision_point": {
          "title": "Decision Point",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "intelligence_level": {
          "enum": [
            "strategic",
            "operational",
            "tactical"
          ],
          "title": "Intelligence Level",
          "type": "string"
        },
        "mitre_attack_groups": {
          "items": {
            "type": "string"
          },
          "title": "Mitre Attack Groups",
          "type": "array"
        },
        "notable_groups": {
          "items": {
            "type": "string"
          },
          "title": "Notable Groups",
          "type": "array"
        },
        "organizational_scope": {
          "title": "Organizational Scope",
          "type": "string"
        },
        "pir_id": {
          "title": "Pir Id",
          "type": "string"
        },
        "prioritized_actors": {
          "items": {
            "$ref": "#/$defs/PrioritizedActor"
          },
          "title": "Prioritized Actors",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "recommended_action": {
          "title": "Recommended Action",
          "type": "string"
        },
        "risk_score": {
          "$ref": "#/$defs/RiskScoreModel"
        },
        "source_elements": {
          "items": {
            "type": "string"
          },
          "title": "Source Elements",
          "type": "array"
        },
        "threat_actor_tags": {
          "items": {
            "type": "string"
          },
          "title": "Threat Actor Tags",
          "type": "array"
        },
        "valid_from": {
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "pir_id",
        "intelligence_level",
        "organizational_scope",
        "decision_point",
        "description",
        "rationale",
        "recommended_action",
        "threat_actor_tags",
        "asset_weight_rules",
        "collection_focus",
        "valid_from",
        "valid_until",
        "risk_score",
        "prioritized_actors"
      ],
      "title": "PIROutput",
      "type": "object"
    },
    "PrioritizedActor": {
      "properties": {
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "analyst_rationale_append": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analyst Rationale Append"
        },
        "excluded_by_analyst": {
          "default": false,
          "title": "Excluded By Analyst",
          "type": "boolean"
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusion Reason"
        },
        "likelihood": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Likelihood",
          "type": "number"
        },
        "manual_likelihood_override": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Likelihood Override"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rationale": {
          "$ref": "#/$defs/Rationale"
        },
        "score_breakdown": {
          "$ref": "#/$defs/ScoreBreakdown"
        }
      },
      "required": [
        "actor_id",
        "name",
        "likelihood",
        "score_breakdown",
        "rationale"
      ],
      "title": "PrioritizedActor",
      "type": "object"
    },
    "Rationale": {
      "properties": {
        "capability_factors": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Capability Factors",
          "type": "object"
        },
        "intent_factors": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Intent Factors",
          "type": "object"
        },
        "opportunity_factors": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Opportunity Factors",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Rationale",
      "type": "object"
    },
    "RiskScoreModel": {
      "properties": {
        "composite": {
          "title": "Composite",
          "type": "integer"
        },
        "impact": {
          "title": "Impact",
          "type": "integer"
        },
        "likelihood": {
          "title": "Likelihood",
          "type": "integer"
        }
      },
      "required": [
        "likelihood",
        "impact",
        "composite"
      ],
      "title": "RiskScoreModel",
      "type": "object"
    },
    "ScoreBreakdown": {
      "properties": {
        "capability": {
          "$ref": "#/$defs/CapabilityComponent"
        },
        "data_quality": {
          "$ref": "#/$defs/DataQualityComponent"
        },
        "intent": {
          "$ref": "#/$defs/IntentComponent"
        },
        "opportunity": {
          "$ref": "#/$defs/OpportunityComponent"
        }
      },
      "required": [
        "intent",
        "capability",
        "opportunity",
        "data_quality"
      ],
      "title": "ScoreBreakdown",
      "type": "object"
    }
  },
  "description": "Top-level envelope for pir_output.json (BEACON 0.18.0+).\n\nschema_version lets downstream consumers gate on the contract version\nwithout inspecting field presence; pirs holds the ordered list of\nper-decision-point records.",
  "properties": {
    "pirs": {
      "items": {
        "$ref": "#/$defs/PIROutput"
      },
      "title": "Pirs",
      "type": "array"
    },
    "schema_version": {
      "default": "0.18.0",
      "description": "Semantic version of the pir_output schema (set by BEACON at emit time).",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "pirs"
  ],
  "title": "PIROutputDocument",
  "type": "object"
}
