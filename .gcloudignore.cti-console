# Root-context Cloud Build ignore file for beacon/Dockerfile.cti-console.
# Paths are relative to the claude_pj root passed to `gcloud builds submit .`.

# VCS / agent harness state
.git/
*/.git/
.claude/
.plans/
.agents/
.codex/

# Python environments and caches
.venv/
*/.venv/
__pycache__/
*/__pycache__/
*.pyc
.pytest_cache/
*/.pytest_cache/
.ruff_cache/
*/.ruff_cache/

# Runtime artifacts / secrets
.env
.env.*
*/.env
*/.env.*
*/input/
*/output/
*/cache/
.beacon_settings.json
*/.beacon_settings.json

# Tests / docs are not needed in the runtime image
*/tests/
*/docs/
*/CHANGELOG.md
*/README.md
*/README.ja.md

# Large reference material and local notes
ref/
.DS_Store
*/.DS_Store

# TRACE runtime template required by Dockerfile.cti-console
!trace/input/
!trace/input/source_catalog.example.yaml
