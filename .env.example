# =============================================================================
# BEACON — Environment Variable Template
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# GCP / Vertex AI  (required for LLM mode; not needed with --no-llm)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
# Vertex AI region (default: us-central1)
# VERTEX_LOCATION=us-central1

# -----------------------------------------------------------------------------
# LLM model overrides  (optional — defaults shown below)
# -----------------------------------------------------------------------------
# BEACON_LLM_SIMPLE=gemini-2.5-flash-lite   # Markdown → JSON conversion
# BEACON_LLM_MEDIUM=gemini-2.5-flash        # PIR text augmentation
# BEACON_LLM_COMPLEX=gemini-2.5-pro         # Likelihood scoring assist

# -----------------------------------------------------------------------------
# LLM output token budgets  (optional — defaults shown below)
# Sized for context_structuring on ~10 KB ja-JP context.md (~6k JSON tokens
# expected, 32k headroom). Bump if your context.md is materially larger or
# context_structuring truncation reappears.
# -----------------------------------------------------------------------------
# BEACON_LLM_MAX_OUTPUT_SIMPLE=32768
# BEACON_LLM_MAX_OUTPUT_MEDIUM=32768
# BEACON_LLM_MAX_OUTPUT_COMPLEX=32768

# -----------------------------------------------------------------------------
# GitHub / GHE Review Workflow  (required for cmd/submit_for_review.py)
# -----------------------------------------------------------------------------
GHE_TOKEN=your-github-personal-access-token
GHE_REPO=owner/repo
# For GitHub Enterprise Server, override the API base URL:
# GHE_API_BASE=https://your-ghe-host/api/v3

# -----------------------------------------------------------------------------
# SAGE Analysis API  (optional — enables --use-sage flag in cmd/generate_pir.py)
# -----------------------------------------------------------------------------
# SAGE_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Activity / IR lookback windows  (optional — defaults shown below)
# -----------------------------------------------------------------------------
# ACTIVITY_WINDOW_DAYS=90         # Capability recency scoring threshold
# BEACON_IR_LOOKBACK_DAYS=365     # IR-boost incident query window

# -----------------------------------------------------------------------------
# Storage backend  (optional — defaults to local filesystem)
# -----------------------------------------------------------------------------
# BEACON_STORAGE=local
# BEACON_STORAGE_BASE_DIR=output
# BEACON_STORAGE_BUCKET=your-gcs-bucket
# BEACON_STORAGE_PREFIX=

# -----------------------------------------------------------------------------
# TRACE integration  (optional — enables Collection tab)
# -----------------------------------------------------------------------------
# TRACE_ROOT_PATH=/path/to/trace/repo
